generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  auth_provider       String    @default("google") // 'email' | 'google'
  role                String    @default("user")   // 'user' | 'admin'
  plan                String    @default("free")   // 'free' | 'pro'
  created_at          DateTime  @default(now()) @db.Timestamptz
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz

  conversion_jobs ConversionJob[]
  merge_sessions  MergeSession[]
  accounts        Account[]

  @@map("users")
}

model ConversionJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?   @db.Uuid
  anon_token       String?   // Anonymous session token to prevent IDOR on guest conversions
  source_type      String
  target_type      String
  status           String // 'queued' | 'scanning' | 'processing' | 'completed' | 'failed' | 'dead_letter'
  worker_type      String // 'document' | 'image' | 'ocr'
  engine_used      String // 'gotenberg' | 'imagemagick' | 'tesseract' | 'cloudconvert'
  retry_count      Int       @default(0)
  clam_scan_result String? // 'clean' | 'infected' | 'error'
  file_count       Int       @default(1)
  r2_input_key     String?
  r2_output_key    String?
  error_message    String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  completed_at     DateTime? @db.Timestamptz

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("conversion_jobs")
}

model MergeSession {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  anon_token    String?  // Anonymous session token to prevent IDOR on guest merges
  file_type     String // 'pdf' | 'word' | 'ppt'
  file_count    Int
  status        String // 'queued' | 'processing' | 'completed' | 'failed'
  r2_output_key String?
  created_at    DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("merge_sessions")
}

model Feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  message    String
  category   String // 'bug' | 'feature' | 'billing' | 'other'
  status     String   @default("open") // 'open' | 'resolved'
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("feedback")
}

// NextAuth Required Model for OAuth Account Linking
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Otp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  code       String
  purpose    String   // 'signup' | 'reset_password'
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([email, code])
  @@map("otps")
}
